{"nodes": [{"id": "_xdrs__core_adrs_principles_001_xdrs_core", "label": "_core-adr-policy-001: XDRS core", "file_type": "document", "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__core_adrs_principles_001_xdrs_core_decision", "label": "Decision: scoped + typed + subject folder structure for XDRS", "file_type": "rationale", "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A standard Decision Record mixes reason, rule, plan, how-to and topic view in one document; XDRS separates these into Policies (source of truth), Research (evidence), Plans (implementation), Skills (procedure) and Articles (overview) because this scales across scopes, stays navigable, and keeps files small and focused for AI agents."}, {"id": "_xdrs__core_adrs_principles_001_xdrs_core_local_scope", "label": "_local scope (workspace-local, non-shared, lowest precedence override)", "file_type": "concept", "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_local is reserved for XDRS elements created locally to a project; it must never be shared or propagated, must always sit last in the root index so it overrides/extends other scopes, and is never linked from shared root indexes even though tools should still try it by default."}, {"id": "_xdrs__core_adrs_principles_001_xdrs_core_filedist_lock", "label": ".filedist.lock external XDRs tracking mechanism", "file_type": "concept", "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file whose path appears in the workspace root .filedist.lock was distributed from an external source repository and must never be modified locally; changes go to the source repo and are re-extracted. Lint tools skip external scopes by default, and version-field diffs across .filedist.lock entries reveal what changed on upgrade."}], "edges": [{"source": "_xdrs__core_adrs_principles_001_xdrs_core_decision", "target": "_xdrs__core_adrs_principles_001_xdrs_core", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__core_adrs_principles_001_xdrs_core", "target": "_xdrs__core_adrs_principles_001_xdrs_core_local_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__core_adrs_principles_001_xdrs_core", "target": "_xdrs__core_adrs_principles_001_xdrs_core_filedist_lock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__core_adrs_principles_001_xdrs_core", "target": "_xdrs__core_adrs_principles_002_policy_standards", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__core_adrs_principles_001_xdrs_core", "target": "_xdrs__core_adrs_principles_skills_001_review_skill", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_core/adrs/principles/001-xdrs-core.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__core_adrs_principles_001_xdrs_core", "target": "_xdrs__core_adrs_principles_skills_002_write_policy_skill", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour