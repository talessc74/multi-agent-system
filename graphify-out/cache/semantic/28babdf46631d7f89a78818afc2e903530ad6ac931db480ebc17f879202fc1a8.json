{"nodes": [{"id": "_xdrs__local_edrs_devops_001_deployment_strategy_policy", "label": "EDR: Deployment Strategy (Push-to-Main Auto-Deploy)", "file_type": "rationale", "source_file": ".xdrs/_local/edrs/devops/001-deployment-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAI? requires frequent iteration with minimal manual intervention. Decision: push to main triggers Cloud Build which deploys automatically to Cloud Run (eai-producao); staging branch pushes deploy to eai-staging. Rollback is done by reverting the commit and pushing to main. Both environments share the same codebase, differing only via environment variables injected at runtime."}, {"id": "_xdrs__local_edrs_devops_001_deployment_strategy_cloud_build", "label": "Google Cloud Build", "file_type": "concept", "source_file": ".xdrs/_local/edrs/devops/001-deployment-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_devops_001_deployment_strategy_cloud_run_eai_producao", "label": "Cloud Run service: eai-producao", "file_type": "concept", "source_file": ".xdrs/_local/edrs/devops/001-deployment-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_devops_001_deployment_strategy_cloud_run_eai_staging", "label": "Cloud Run service: eai-staging", "file_type": "concept", "source_file": ".xdrs/_local/edrs/devops/001-deployment-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_xdrs__local_edrs_devops_001_deployment_strategy_policy", "target": "_xdrs__local_edrs_devops_001_deployment_strategy_cloud_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_local/edrs/devops/001-deployment-strategy.md", "source_locati