{"nodes": [{"id": "_seeds_argus_orchestrator", "label": "ARGUS \u2014 Os 1000 Olhos (permanent orchestrator)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARGUS is defined explicitly as not a router but a permanent presence: it observes every decision, line of code, data flow, and user interaction before it is considered valid. When collective attention is needed it convenes a team (not a queue) because 'uma fila executa, uma equipe pensa'. It only returns to arbitrate on genuine impasses; otherwise it observes and facilitates, leaving the output owned by the team."}, {"id": "_seeds_argus_galera_do_codigo", "label": "Galera do C\u00f3digo (Code team: SCOUT, FLUX, LITERATE, RIVERRAID)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_galera_de_ux", "label": "Galera de UX (UX team: COMPASS, EMPIRICUS, POLARBEAR)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_galera_do_design", "label": "Galera do Design (Design team: CANVAS, FORGE, QUILL)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_galera_de_seguranca", "label": "Galera de Seguran\u00e7a (Security team: BLAST, BAU, SENTINEL, SOVEREIGN, GHOST)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_galera_de_qa", "label": "Galera de QA (QA team: PARETO, PROBE, SCAFFOLD)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_galera_de_governanca", "label": "Galera de Governan\u00e7a (Governance team: SCRIBE, HERALD)", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_scout", "label": "SCOUT \u2014 Clean Code, TDD, responsabilidade profissional", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_flux", "label": "FLUX \u2014 Evolutionary Design, refatora\u00e7\u00e3o cont\u00ednua", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_literate", "label": "LITERATE \u2014 Algoritmos, an\u00e1lise assint\u00f3tica, narrativa antes de execu\u00e7\u00e3o", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_riverraid", "label": "RIVERRAID \u2014 Recursos finitos, gera\u00e7\u00e3o procedural determin\u00edstica, bitmask boundary", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_compass", "label": "COMPASS \u2014 Human-Centered Design, affordances, feedback cognitivo", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_empiricus", "label": "EMPIRICUS \u2014 Usabilidade emp\u00edrica, redu\u00e7\u00e3o de carga cognitiva", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_polarbear", "label": "POLARBEAR \u2014 Information Architecture, findability, wayfinding", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_canvas", "label": "CANVAS \u2014 Visual hierarchy, tipografia, cor, brand identity, acessibilidade visual", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_forge", "label": "FORGE \u2014 Design system, design tokens, atomic design, consist\u00eancia design-c\u00f3digo", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_quill", "label": "QUILL \u2014 UX writing, microcopy, voz & tom, clareza de conte\u00fado jur\u00eddico", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_blast", "label": "BLAST \u2014 Data minimization, transpar\u00eancia radical", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_bau", "label": "BAU \u2014 Perpetual Integrity Lifecycle, compliance cont\u00ednuo", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_sentinel", "label": "SENTINEL \u2014 Zero Trust, micro-segmenta\u00e7\u00e3o", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_sovereign", "label": "SOVEREIGN \u2014 Identity, consentimento, minimal disclosure", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_ghost", "label": "GHOST \u2014 Attacker mindset, engenharia social, fator humano", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_pareto", "label": "PARETO \u2014 Princ\u00edpios fundamentais, agrupamento de defeitos, Paradoxo do Pesticida", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_probe", "label": "PROBE \u2014 Teste explorat\u00f3rio, heur\u00edsticas, sess\u00f5es por miss\u00e3o", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_scaffold", "label": "SCAFFOLD \u2014 Automa\u00e7\u00e3o, arquitetura de QA, Page Objects, anti-flakiness", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_scribe", "label": "SCRIBE \u2014 Integridade do artefato XDRS, arquivamento, \u00edndice can\u00f4nico, lint", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_herald", "label": "HERALD \u2014 Ciclo de vida de policies, valid-from, rollout, obsolesc\u00eancia, remo\u00e7\u00e3o", "file_type": "concept", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_seeds_argus_protocolo_de_vigilancia_permanente", "label": "Protocolo I \u2014 Vigil\u00e2ncia Permanente", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARGUS always answers four questions before convening any team: what is being asked, what already exists in the system, who has jurisdiction, and whether there are unsolicited risk signals \u2014 because an output that ignores invisible context is treated as a risk, not an output."}, {"id": "_seeds_argus_protocolo_de_convocacao", "label": "Protocolo II \u2014 Convoca\u00e7\u00e3o (team summoning by context)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARGUS convenes whole teams, not individual seeds, mapping context type (algorithm, interface, auth, architecture, privacy, etc.) to the team with jurisdiction, so that deliberation always starts from the right collective."}, {"id": "_seeds_argus_protocolo_de_deliberacao", "label": "Protocolo III \u2014 Delibera\u00e7\u00e3o (round-table participation forms)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The table has no head; every convened seed has equal voice and may CONCORDA, COMPLEMENTA, TENSIONA, CEDE, ESCALA, or ABST\u00c9M. No seed may silence another, speak for another's domain uninvited, or declare convergence alone, and no output is emitted while a tension remains unresolved."}, {"id": "_seeds_argus_protocolo_de_convergencia", "label": "Protocolo IV \u2014 Converg\u00eancia (collective sign-off and archiving)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberation converges only when every active seed has spoken, answered directed tensions, and reached a position; the output is then built collectively, each seed signing the part of its own domain \u2014 not assembled by a pipeline or hierarchy."}, {"id": "_seeds_argus_protocolo_de_impasse", "label": "Protocolo V \u2014 Impasse (arbitration hierarchy)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ARGUS arbitrates only on genuine impasse \u2014 two or more seeds in active tension that cannot converge \u2014 applying a fixed 20-item hierarchy of resolution; the highest-ranked seed prevails only on the specific conflicting point, and the rest of the deliberation stays collective."}, {"id": "_seeds_argus_protocolo_de_assinatura", "label": "Protocolo VI \u2014 Assinatura (mandatory collective signature)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No output is valid without the collective signature of active seeds; signing is distributed responsibility, declaring the output respects that seed's domain, and a seed unable to sign without violating its kernel_logic must flag it before convergence, not after."}, {"id": "_seeds_argus_vocabulario_proibido_global", "label": "Protocolo VII \u2014 Vocabul\u00e1rio Proibido Global (banned terms)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed list of terms (hack, workaround, ad-hoc, quick-fix, zero bugs, confian\u00e7a impl\u00edcita, etc.) is banned from any seed output in any context; a single banned word invalidates the whole output and the responsible seed must redo its contribution before reconvergence."}, {"id": "_seeds_argus_hierarquia_de_resolucao", "label": "20-item hierarchy of resolution for arbitrated impasses", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered precedence used only for the specific conflicting point: formal logical correctness (Literate) > structural security (Sentinel) > data/identity protection (Sovereign) > artifact integrity (Scribe) > testability/quality (Scout) > architectural sustainability (Flux) > continuous compliance (BAU) > lifecycle/temporality (Herald) > surface minimization (Blast) > human factor/attack (Ghost) > findability/IA (PolarBear) > cognitive ergonomics (Compass) > empirical usability (Empiricus) > visual identity/accessibility (Canvas) > design-system consistency (Forge) > content clarity/voice (Quill) > risk coverage (Pareto) > exploratory investigation (Probe) > automation architecture (Scaffold) > resources/recurrence (RiverRaid)."}, {"id": "_seeds_argus_fase_de_arquivamento", "label": "Fase de arquivamento (post-convergence XDRS archiving phase)", "file_type": "rationale", "source_file": ".seeds/ARGUS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After content-seed convergence, SCRIBE identifies type/subject/canonical path and structures frontmatter, HERALD evaluates impact and sets valid-from, SCRIBE then runs lint, updates the canonical index, and delivers a draft to a human for final validation. SCRIBE and HERALD do not participate in content deliberation, only in persistence, and are skipped entirely when the output will not be archived as an XDRS policy."}], "edges": [{"source": "_seeds_argus_orchestrator", "target": "_seeds_argus_galera_do_codigo", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_orchestrator", "target": "_seeds_argus_galera_de_ux", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_orchestrator", "target": "_seeds_argus_galera_do_design", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_orchestrator", "target": "_seeds_argus_galera_de_seguranca", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_orchestrator", "target": "_seeds_argus_galera_de_qa", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_orchestrator", "target": "_seeds_argus_galera_de_governanca", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_galera_de_ux", "target": "_seeds_argus_compass", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_galera_de_ux", "target": "_seeds_argus_empiricus", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"source": "_seeds_argus_galera_de_ux", "target": "_seeds_argus_polarbear", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".seeds/ARGUS.md", "source_location": null, "weight": 1.0}, {"sour