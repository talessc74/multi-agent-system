{"nodes": [{"id": "_xdrs__local_edrs_governance_001_lgpd_anonymization_policy", "label": "EDR: LGPD Anonymization", "file_type": "rationale", "source_file": ".xdrs/_local/edrs/governance/001-lgpd-anonymization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAI? processes sensitive personal legal data (names, CPF, contracts, medical/employment data) submitted by users. Under LGPD, all user-submitted case data must be anonymized (via anonymizer.ts) before persisting to Firestore; raw text must never be stored. Gemini calls during simulation use original non-anonymized text but are transient. Secondary writes (save, history, stats) are isolated in independent try-catch blocks so a failure never blocks the user from seeing their result."}, {"id": "_xdrs__local_edrs_governance_001_lgpd_anonymization_anonymizer_ts", "label": "anonymizer.ts", "file_type": "code", "source_file": ".xdrs/_local/edrs/governance/001-lgpd-anonymization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_governance_001_lgpd_anonymization_firestore", "label": "Firestore", "file_type": "concept", "source_file": ".xdrs/_local/edrs/governance/001-lgpd-anonymization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_governance_001_lgpd_anonymization_laudo_acessado_em", "label": "laudoAcessadoEm access-log field", "file_type": "concept", "source_file": ".xdrs/_local/edrs/governance/001-lgpd-anonymization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_governance_001_lgpd_anonymization_terms_of_use", "label": "Terms of Use v1.2", "file_type": "concept", "source_file": ".xdrs/_local/edrs/governance/001-lgpd-anonymization.md", "source_location": null, "source_url": null, "captured_a