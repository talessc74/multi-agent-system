{"nodes": [{"id": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_policy", "label": "EDR-003 (principles): Mode 4 Judge Frame Contract", "file_type": "rationale", "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single bilateral judge frame caused 75-point run-to-run variance in Mode 4 when userSide==='DEFENSE', because static author petitions (claim-sympathetic language) vs AI-improved defenses (structured reasoning) let the judge model non-deterministically pick a claim-sympathetic or defense-quality interpretation frame. Decision: split the judge prompt by userSide \u2014 AUTHOR frame keeps the original stable bilateral 'who wins' framing; DEFENSE frame instead asks the judge to evaluate the technical soundness of the defense against the claim (same approach as Mode 2). success_probability still always represents the author's probability (EDR-001 invariant); the display layer inverts it for R\u00c9U users. Frame is applied at inference/prompt time only, not at judge-agent creation time, preserving judge impartiality (EDR-003 application)."}, {"id": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_author_frame", "label": "AUTHOR Frame (bilateral judge prompt)", "file_type": "concept", "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_defense_frame", "label": "DEFENSE Frame (defense-quality judge prompt)", "file_type": "concept", "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_mode2_defesa_assistida", "label": "Mode 2 (Defesa Assistida)", "file_type": "concept", "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_mode4simulation_test_ts", "label": "mode4Simulation.test.ts", "file_type": "code", "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_policy", "target": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_author_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_policy", "target": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_defense_frame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_policy", "target": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_mode2_defesa_assistida", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_local/edrs/principles/003-mode4-judge-frame-contract.md", "source_location": null, "weight": 1.0}, {"source": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_policy", "target": "_xdrs__local_edrs_principles_003_mode4_judge_frame_contract_mode4simulation_test_ts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".xdrs/_local