rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidSimulation(data) {
      return data.keys().hasAll(['caseDescription', 'area', 'finalSuccessProbability', 'createdAt', 'isWin', 'userId']) &&
             data.keys().size() <= 15 &&
             data.caseDescription is string && data.caseDescription.size() <= 64000 &&
             data.area is string && data.area.size() <= 50 &&
             data.finalSuccessProbability is number &&
             data.isWin is bool &&
             (data.userId == null || (request.auth != null && data.userId is string && data.userId == request.auth.uid)) &&
             data.createdAt == request.time;
    }

    function isValidGlobalStats(data) {
      return data.keys().hasAll(['totalSimulations', 'totalWins', 'lastUpdated']) &&
             data.totalSimulations is int &&
             data.totalWins is int &&
             data.lastUpdated == request.time;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'stripePaymentIntentId', 'amount', 'currency', 'status', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.stripePaymentIntentId is string && data.stripePaymentIntentId.size() <= 64 &&
             data.amount is int &&
             data.currency is string && data.currency.size() == 3 &&
             data.status is string &&
             data.createdAt == request.time;
    }

    // simulations collection
    match /simulations/{simId} {
      allow create: if isValidSimulation(incoming());
      allow read: if resource.data.userId == null || isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // stats collection
    match /stats/{statId} {
      allow read: if true;
      allow create: if isValidGlobalStats(incoming());
      allow update: if incoming().keys().hasOnly(['totalSimulations', 'totalWins', 'lastUpdated'])
                  && incoming().totalSimulations is int
                  && incoming().totalWins is int
                  && incoming().lastUpdated == request.time;
    }

    // regions collection (read-only for users)
    match /regions/{regionId} {
      allow read: if true;
      allow write: if false;
    }

    // payments collection (write only via server Admin SDK)
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // simRecovery — written only via server Admin SDK, UUID is the access key
    match /simRecovery/{sessionId} {
      allow read: if (resource.data.userId != null
                      && request.auth != null
                      && resource.data.userId == request.auth.uid)
                  || resource.data.userId == null;
      allow write: if false;
    }

    // chats collection — created and updated only via Admin SDK (server)
    match /chats/{simulationId} {
      allow read: if isSignedIn() &&
                     isValidId(simulationId) &&
                     resource.data.userId == request.auth.uid;
      allow create: if false;  // server-only via Admin SDK
      allow update: if false;  // server-only via Admin SDK
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
                       isValidId(simulationId) &&
                       get(/databases/$(database)/documents/chats/$(simulationId)).data.userId == request.auth.uid;
        allow write: if false;  // server-only via Admin SDK
      }
    }

    // users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().keys().hasOnly(['email', 'createdAt', 'accessLevel'])
        && incoming().accessLevel == 'free'
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;

      match /payments/{simulationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

  }
}
